<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.example.anndoodle.DoodleView
        android:id="@+id/doodle_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_bg_toggle"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="พื้นหลัง : ใส"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#CC1E1E1E"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="21dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_zoom_reset"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:text="100%"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#CC1E1E1E"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cornerRadius="21dp" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/floating_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_margin="12dp"
        app:cardBackgroundColor="#E61E1E1E"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/drag_handle_area"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:background="@android:color/transparent">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="6dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_drag_handle" />
            </FrameLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/color_container"
                    android:layout_width="wrap_content"
                    android:layout_height="52dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_brush"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:value="16.0"
                    android:valueFrom="2.0"
                    android:valueTo="60.0"
                    app:thumbColor="#FFFFFF"
                    app:trackColorActive="#00E5FF"
                    app:trackColorInactive="#44FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_eraser"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_eraser"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#E0E0E0"
                    app:backgroundTint="#383838"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_trash"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#E0E0E0"
                    app:backgroundTint="#383838"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_done"
                    android:layout_width="52dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_check"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="#000000"
                    app:backgroundTint="#00E676"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>